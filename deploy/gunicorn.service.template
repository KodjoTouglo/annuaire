[Unit]
Description=Annuaire (${APP_USER})
After=network.target postgresql.service

[Service]
User=${APP_USER}
# www-data is nginx's group, so it can reach the socket
Group=www-data
WorkingDirectory=/home/${APP_USER}/annuaire
RuntimeDirectory=annuaire-${APP_USER}
ExecStart=/home/${APP_USER}/annuaire/venv/bin/gunicorn config.wsgi:application \
    --workers 2 \
    --umask 007 \
    --bind unix:/run/annuaire-${APP_USER}/gunicorn.sock
Restart=on-failure

[Install]
WantedBy=multi-user.target
