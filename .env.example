# Copy to .env and fill in. Never commit .env.

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# 1 only on your own machine
DEBUG=0

# Comma separated, e.g. michel.203-0-113-10.sslip.io (localhost on your machine)
ALLOWED_HOSTS=localhost

# Set to 1 once HTTPS works (secure cookies)
HTTPS=0

# Port published on 127.0.0.1, given by the teacher on the VPS
APP_PORT=8000

# Used by both PostgreSQL and Django. Leave DB_NAME empty to run
# manage.py with SQLite outside Docker.
DB_NAME=annuaire
DB_USER=annuaire
DB_PASSWORD=
