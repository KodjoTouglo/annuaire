# Copy to .env and fill in. Never commit .env.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# 1 only on your own machine
DEBUG=0

# Comma separated, e.g. alice.203-0-113-10.sslip.io
ALLOWED_HOSTS=

# Set to 1 once HTTPS works (secure cookies)
HTTPS=0

# Leave DB_NAME empty to use SQLite locally
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
